# ── Model Paths ───────────────────────────────────────────
# Update these to point to your actual .h5 model files
LUNG_MODEL_PATH=models/lung_cancer_model.h5
SKIN_MODEL_PATH=models/skin_cancer_model.h5
BREAST_MODEL_PATH=models/breast_cancer_model.h5

# ── Image Sizes ───────────────────────────────────────────
# Must match the input size used during training
LUNG_IMG_SIZE=(300,300)
SKIN_IMG_SIZE=(224,224)
BREAST_IMG_SIZE=(224,224)

# ── Class Labels ──────────────────────────────────────────
# Must match the class_indices order from your ImageDataGenerator
LUNG_CLASSES=["lung_aca","lung_n","lung_scc"]
SKIN_CLASSES=["akiec","bcc","bkl","df","mel","nv","vasc"]
BREAST_CLASSES=["benign","malignant","normal"]

# ── Grad-CAM Layer Names ──────────────────────────────────
# The last convolutional layer in your model
# For EfficientNetB3: "top_conv"
# To find: model.summary() and look for last Conv2D layer name
LUNG_GRADCAM_LAYER=top_conv
SKIN_GRADCAM_LAYER=top_conv
BREAST_GRADCAM_LAYER=top_conv

# ── Embedding Layer Names ─────────────────────────────────
# Layer just before the Dense classifier head
# For EfficientNetB3: "top_activation"
LUNG_EMBED_LAYER=top_activation
SKIN_EMBED_LAYER=top_activation
BREAST_EMBED_LAYER=top_activation

# ── Uncertainty ───────────────────────────────────────────
MC_DROPOUT_PASSES=30
UNCERTAINTY_THRESHOLD=0.10
